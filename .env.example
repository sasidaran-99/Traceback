# Traceback Environment Configuration Template
# Copy this file to .env and customize for your local development environment.
# DO NOT commit real secrets or credentials to source control.

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traceback_db
DB_USER=traceback_user
DB_PASSWORD=traceback_password

# GitHub Integration
# Personal access token with repo scope (or GitHub App configuration)
GITHUB_API_TOKEN=ghp_your_github_personal_access_token_placeholder
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_placeholder
GITHUB_DEFAULT_OWNER=your_github_org_or_username
GITHUB_DEFAULT_REPO=payment-service

# Frontend Dashboard (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=Traceback Investigation Platform

# Feature Flags (Deferred components default to false in early phases)
FEATURE_KAFKA_INGESTION_ENABLED=false
FEATURE_AI_EXPLANATION_ENABLED=true

# Bifrost AI Gateway (Phase 4)
# Virtual key and proxy configuration for OpenAI-compatible model routing
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=sk-bf-placeholder-virtual-key
BIFROST_MODEL=gpt-4o
BIFROST_TIMEOUT_SECONDS=15
BIFROST_MAX_RETRIES=2

# Tavily Technical Research API (Phase 4)
# Automated research for exception signatures and known bug patterns
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=tvly-placeholder-api-key
TAVILY_MAX_SEARCHES=3
TAVILY_TIMEOUT_SECONDS=10

# Security Boundaries & Hardening (Phase 6)
# Explicit allowlist of server directory roots authorized for Git analysis (comma-separated)
# Leave blank to default to project workspace root and system temp directory
TRACEBACK_ALLOWED_REPO_ROOTS=C:\Users\Sasidaran\Desktop\Sasidaran\Projects\TraceBack

# Production CORS Origin Allowlist (comma-separated; in production, wildcards and localhost are forbidden)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:8080
